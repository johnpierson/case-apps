<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsCaseAddin>true</IsCaseAddin>
    <RootNamespace>Case.AppsRibbon</RootNamespace>
    <AssemblyName>Case.AppsRibbon</AssemblyName>
    <OutputType>Library</OutputType>
    <MyType>Windows</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>

  <!-- Ribbon loads icons via GetManifestResourceStream("Case.AppsRibbon.<file>.png") -->
  <ItemGroup>
    <None Remove="Icons\**\*.png" />
    <EmbeddedResource Include="Icons\**\*.png">
      <LogicalName>Case.AppsRibbon.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

